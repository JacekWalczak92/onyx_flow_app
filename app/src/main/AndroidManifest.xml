<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Aplikacja prywatna (sideload): pełna lista aplikacji, by znaleźć natywny czat -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Pozwala sprawdzić, czy natywna aplikacja ChatGPT jest zainstalowana -->
    <queries>
        <package android:name="com.openai.chatgpt" />
        <package android:name="com.anthropic.claude" />
    </queries>

    <application
        android:name=".FloatChatApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_bubble"
        android:label="@string/app_name"
        android:theme="@style/Theme.FloatChat"
        tools:targetApi="35">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pozycja "Zapytaj AI" w menu zaznaczenia tekstu (np. w NeoReader) -->
        <activity
            android:name=".ui.ProcessTextActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/process_text_label"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.FloatChat.Invisible">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Udostępnij → FloatChat -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".overlay.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating chat bubble overlay shown above other apps" />
        </service>

        <!-- Strażnik: przywraca bąbel po ubiciu przez system, po restarcie i po aktualizacji -->
        <receiver
            android:name=".overlay.WatchdogReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Kafelek w szybkich ustawieniach: włącz/wyłącz bąbel -->
        <service
            android:name=".overlay.BubbleTileService"
            android:exported="true"
            android:icon="@drawable/ic_bubble"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
